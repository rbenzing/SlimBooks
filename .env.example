# Slimbooks environment configuration
#
# This is the ONLY environment template. Copy it to `.env` and edit that:
#
#   cp .env.example .env
#
# `.env` is the single file the application reads, in development and in
# production alike. There is no `.env.production`; a second template only
# created two places to keep the same list of keys in step, and they drifted.
#
# Every variable below is read by the application. Anything you set that is not
# listed here is ignored, and anything listed here can be left blank to take the
# default shown in the comment.
#
# Values saved in the Settings screens take precedence over the ones here — the
# entries below are the defaults an install starts from.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3002
HOST=localhost
NODE_ENV=development

# Where the browser reaches this server. Used in emailed links.
CLIENT_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Security - GENERATE YOUR OWN before exposing this to a network
# ---------------------------------------------------------------------------
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
#
# Left at their defaults, the application signs tokens with a value published
# in this repository, which means anyone can mint a valid session.
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=

# Token lifetimes, in milliseconds
ACCESS_TOKEN_EXPIRY=7200000
REFRESH_TOKEN_EXPIRY=604800000
EMAIL_TOKEN_EXPIRY=86400000
PASSWORD_RESET_EXPIRY=3600000

# Password hashing cost
BCRYPT_ROUNDS=12

# Account protection
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=1800000
REQUIRE_EMAIL_VERIFICATION=false

# Initial admin password, used only when seeding an empty database
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Filesystem locations
# ---------------------------------------------------------------------------
# All resolved to absolute paths at boot, relative to the project root when set
# relatively. Under DB_DRIVER=sqlite and STORAGE_DRIVER=disk, DATA_DIR and
# UPLOAD_DIR are the two directories that MUST survive a redeploy — everything
# else is rebuilt from this file. On a host that cannot promise that, use
# DB_DRIVER=mysql and STORAGE_DRIVER=database instead; then neither matters.
DATA_DIR=./data
UPLOAD_DIR=./uploads
# Where the built SPA lives. Defaults to dist/client; you rarely need this.
STATIC_DIR=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Which backend to open: sqlite (default) or mysql. Existing installs need set
# nothing — sqlite keeps the behaviour they already have.
DB_DRIVER=sqlite

# --- sqlite only ---
# Relative values resolve INSIDE DATA_DIR, so moving the data directory moves
# the database with it. An absolute value is used as-is.
DB_PATH=slimbooks.db
DB_BACKUP_PATH=./data/backups
DB_TIMEOUT=5000

# --- mysql only ---
# All four are required when DB_DRIVER=mysql, and the boot fails naming every
# one that is missing rather than erroring on the first query. DB_PASSWORD may
# be empty, but it must be present — an empty password is a configuration, an
# absent one is a mistake.
#
# Needs MySQL 8.0.13+ or MariaDB 10.2+ (older servers cannot give a column an
# expression default, which every created_at here uses) and InnoDB (MyISAM
# ignores transactions silently). Both are checked at boot.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=slimbooks
# DB_USER=slimbooks
# DB_PASSWORD=
# DB_SSL=false
# DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Uploaded files
# ---------------------------------------------------------------------------
# Where company logos live: disk (default) or database.
#
# Use `database` on any host whose filesystem is wiped on redeploy — with
# `disk` there, every logo disappears on the next deploy. Objects then travel
# with the database backup instead of being a separate thing to remember.
STORAGE_DRIVER=disk

# ---------------------------------------------------------------------------
# CORS and rate limiting
# ---------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:8080
CORS_CREDENTIALS=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# File uploads
# ---------------------------------------------------------------------------
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
# The variable names are SMTP_*, not EMAIL_*. An earlier version of this file
# documented EMAIL_HOST / EMAIL_USER / EMAIL_PASSWORD, which nothing reads —
# setting those configured nothing at all.
#
# Settings > Email Settings offers a provider dropdown that fills the host,
# port and encryption in together, and anything saved there wins over these.
SMTP_HOST=
SMTP_PORT=587
# true for SSL on connect (port 465); false for STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@slimbooks.app

# ---------------------------------------------------------------------------
# Stripe (optional - for collecting invoice payments)
# ---------------------------------------------------------------------------
# The secret key and webhook secret are read on the server only and are never
# sent to the browser.
#
# Keys:     https://dashboard.stripe.com/apikeys
# Webhooks: https://dashboard.stripe.com/webhooks
#           endpoint: https://your-host/api/webhooks/stripe
#           events:   checkout.session.completed, payment_intent.succeeded
#
# Setting both keys here switches the integration on automatically.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Left unset, test mode is inferred from the key (sk_test_ vs sk_live_)
# STRIPE_TEST_MODE=true

# Currency Stripe charges in, when an invoice does not name one
DEFAULT_CURRENCY=usd

# ---------------------------------------------------------------------------
# Google OAuth (optional - for "Sign in with Google")
# ---------------------------------------------------------------------------
# Setting both switches the integration on automatically.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
BACKUP_ENABLED=false
# Quoted because deploy.sh sources this file; unquoted, the shell reads the
# spaces as a command to run.
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION=30
BACKUP_DIR=./data/backups

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Defaults to debug in development and info otherwise
LOG_LEVEL=


# ---------------------------------------------------------------------------
# Development helpers - leave off in production
# ---------------------------------------------------------------------------
# Debug endpoints are governed by FEATURE_DEBUG above.
ENABLE_SAMPLE_DATA=false

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------
# How TLS reaches this process. Read by the server itself, unlike the
# ENABLE_HTTPS setting this replaces, which nothing ever read — so a deployment
# that asked for HTTPS quietly served plain HTTP.
#
#   off    plain HTTP. Development, or a container behind a service mesh.
#   self   this process terminates TLS using the key/cert below.
#   proxy  something in front terminates TLS: IIS, Hostinger, nginx, Caddy.
TLS_MODE=off
TLS_KEY_PATH=certs/server.key
TLS_CERT_PATH=certs/server.crt

# Proxy hops to trust in `proxy` mode. Leave at 1 unless you have a chain.
#
# This is not cosmetic. Without it every request appears to come from the
# proxy's single address, so the rate limit below is shared by all users at
# once and the entire install locks out together.
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Feature toggles
# ---------------------------------------------------------------------------
# Each is auto | on | off — deliberately three states, not a boolean:
#
#   auto   enable if the dependency is actually available on this host
#   on     require it; the process REFUSES TO START if it is missing
#   off    never mount it; the routes do not exist
#
# `on` is how a production deployment turns a silent degradation into a startup
# failure. `auto` is how the same image runs on a host that lacks the
# dependency. Leave them blank for auto.
FEATURE_PDF=
FEATURE_EMAIL=
FEATURE_STRIPE=
FEATURE_OAUTH=
FEATURE_SCHEDULER=
FEATURE_UPLOADS=
FEATURE_DB_ADMIN=
FEATURE_SIGNUP=
FEATURE_DEBUG=

# ---------------------------------------------------------------------------
# Recurring invoice scheduler
# ---------------------------------------------------------------------------
# Runs inside the application, so no crontab is needed on any host. Set
# FEATURE_SCHEDULER=off if an external scheduler owns this instead; the
# /api/cron endpoint is then mounted behind admin authentication.
SCHEDULER_INTERVAL_MS=3600000
SCHEDULER_LEASE_TTL_MS=3600000
SCHEDULER_INITIAL_DELAY_MS=15000

# ---------------------------------------------------------------------------
# Docker: the container's view of the network
# ---------------------------------------------------------------------------
# Read by docker-compose.yml, not by the application. A container's route to
# the database is not the host's — 127.0.0.1 inside a container is the
# container itself — so these are passed in as DB_HOST and DB_PORT, overriding
# the values above for the container only. That lets one .env serve both
# `npm run dev` and `docker compose up`, and keeps the name of your database
# container out of a committed file.
#
#   database container publishing a host port (nothing else to do):
#     DOCKER_DB_HOST=host.docker.internal
#     DOCKER_DB_PORT=3306
#
#   database container reached by name (no published port needed):
#     docker network connect slimbooks_default <db-container>
#     DOCKER_DB_HOST=<db-container>
#     DOCKER_DB_PORT=3306
#
# Ignored entirely under DB_DRIVER=sqlite.
DOCKER_DB_HOST=host.docker.internal
DOCKER_DB_PORT=3306

# The address users reach the container on. Must match the scheme TLS_MODE
# produces — compose sets TLS_MODE=self, so this is https by default.
DOCKER_CLIENT_URL=https://localhost:8080
