# Logs
# Trailing slash: directory only, so a source FILE named `logs` is not caught.
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
#
# Every variant is ignored and the template is the one exception, so a real
# environment file cannot be committed by picking a name nobody thought of.
# `.env.production` was tracked precisely because it was not on the old list.
.env*
!.env.example

# Database and data
#
# These are anchored with a leading slash so they name TWO specific runtime
# directories and nothing else. The pattern here was `data`, which git matches
# against any file or directory of that name at any depth — so it also caught
# `src/utils/data/`, and four source modules totalling 555 lines silently never
# reached the repository. Everything still built locally, because the files
# were on disk; it only surfaced when CI cloned the repo and could not resolve
# `@/utils/data`.
#
# Anything added here should be anchored unless it genuinely belongs at every
# depth.
/data/
/server/data/
*.db
# WAL mode leaves these two alongside the database file.
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

package-lock.json
.claude/*
CLAUDE.md
certs/*
.gitignore
/coverage
public/uploads/*
# Release archives produced by the packaging step
*.tar.gz

# Superpowers design specs and implementation plans stay local
docs/superpowers/

# Uploaded files are operator data, not source. UPLOAD_DIR points here by
# default; keep the directory so a fresh clone has somewhere to write.
uploads/*
!uploads/.gitkeep
